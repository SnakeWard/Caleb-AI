    "secret",
    "env_value",
    "credential",
    "auth_token",
    "private_key",
    "raw_prompt_text",
    "raw_model_output_text",
    "unredacted_user_content",
    "unredacted_provider_response"
  ],
  "default_action": "replace_with_digest",
  "created_at": "2026-07-03T08:10:00.000Z",
  "notes": [
    "R19 static redaction policy example.",
    "Refs, digests, statuses, summaries, warnings, and errors are allowed; raw text is not."
  ]
