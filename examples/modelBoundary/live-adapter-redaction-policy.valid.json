{
  "schema_version": "0.1.0",
  "policy_id": "redaction_policy_r19_default",
  "policy_version": "1.0.0",
  "scope": [
    "live_adapter_request",
    "live_adapter_response",
    "ledger_event",
    "runtime_storage_record",
    "final_output_record"
