    "env_values_blocked": true,
    "credentials_blocked": true,
    "auth_tokens_blocked": true,
    "private_keys_blocked": true,
    "unredacted_user_content_blocked": true,
    "unredacted_provider_response_blocked": true
  },
  "sensitive_categories": [
