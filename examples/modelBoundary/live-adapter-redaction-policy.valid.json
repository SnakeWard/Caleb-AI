  "safety_profile_id": "live_adapter_safety_profile_r19",
  "redaction_required": true,
  "raw_prompt_allowed": false,
  "raw_output_allowed": false,
  "ledger_raw_prompt_allowed": false,
  "ledger_raw_output_allowed": false,
  "runtime_storage_raw_prompt_allowed": false,
  "runtime_storage_raw_output_allowed": false,
  "allowed_content": {
    "ids_allowed": true,
    "refs_allowed": true,
    "digests_allowed": true,
    "statuses_allowed": true,
    "trust_summaries_allowed": true,
    "usage_summaries_allowed": true,
    "timing_summaries_allowed": true,
    "warning_summaries_allowed": true,
    "error_summaries_allowed": true,
    "raw_text_allowed": false
