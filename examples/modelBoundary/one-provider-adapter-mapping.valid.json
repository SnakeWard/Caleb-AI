{
  "request_mapping": {
    "maps_from_live_adapter_request": true,
    "provider_specific_request_shape_defined": false,
    "raw_prompt_forwarding_allowed": false,
    "prompt_digest_required": true,
    "redaction_result_required": true,
    "safety_profile_required": true,
    "evidence_refs_supported": true,
    "context_refs_supported": true,
    "secrets_in_payload_allowed": false,
    "notes": ["Mapping accepts refs and digests only."]
  },
  "response_mapping": {
    "maps_to_live_adapter_response": true,
    "provider_specific_response_shape_defined": false,
    "raw_output_storage_allowed": false,
    "output_digest_required": true,
    "output_ref_required": true,
    "token_usage_recorded_if_available": true,
    "latency_recorded_if_available": true,
    "finish_reason_recorded_if_available": true,
    "successful_response_promotes_trust": false,
    "notes": ["Successful responses remain unverified provider output."]
  },
  "failure_mapping": {
