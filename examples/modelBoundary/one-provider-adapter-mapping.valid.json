      "live_provider_not_enabled",
      "provider_not_allowlisted",
      "missing_api_key",
      "network_disabled",
      "provider_timeout",
      "provider_rate_limited",
      "provider_auth_failed",
      "provider_rejected_request",
      "provider_malformed_response",
      "response_validation_failed",
      "cost_limit_exceeded",
      "unknown_provider_error"
    ],
    "missing_opt_in_maps_to": "live_provider_not_enabled",
    "provider_not_allowlisted_maps_to": "provider_not_allowlisted",
    "missing_api_key_maps_to": "missing_api_key",
    "network_disabled_maps_to": "network_disabled",
    "provider_timeout_maps_to": "provider_timeout",
    "provider_rate_limited_maps_to": "provider_rate_limited",
    "provider_auth_failed_maps_to": "provider_auth_failed",
    "provider_rejected_request_maps_to": "provider_rejected_request",
    "provider_malformed_response_maps_to": "provider_malformed_response",
    "response_validation_failed_maps_to": "response_validation_failed",
    "cost_limit_exceeded_maps_to": "cost_limit_exceeded",
    "unknown_provider_error_maps_to": "unknown_provider_error",
    "failures_claim_verified_truth": false,
    "failures_promote_trust": false,
    "notes": ["Failures normalize status only."]
  },
  "redaction_compatibility": {
    "redaction_policy_required": true,
    "redaction_manifest_required": true,
    "redaction_result_required": true,
    "raw_prompt_allowed": false,
    "raw_output_allowed": false,
    "raw_transcript_storage_allowed": false,
    "redaction_promotes_trust": false,
    "redaction_metadata_promotes_trust": false,
    "notes": ["Redaction compatibility is mandatory."]
  },
  "ledger_compatibility": {
    "ledger_provenance_required": true,
    "raw_prompt_written_to_ledger": false,
    "raw_output_written_to_ledger": false,
    "api_key_written_to_ledger": false,
    "secrets_written_to_ledger": false,
    "env_values_written_to_ledger": false,
    "refs_digests_statuses_allowed": true,
    "ledger_write_promotes_trust": false,
    "ledger_presence_promotes_trust": false,
    "notes": ["Ledger writes do not promote trust."]
  },
  "storage_compatibility": {
    "runtime_storage_contract_required": true,
    "persistent_transcript_storage_allowed": false,
    "raw_provider_output_storage_tier": "T0",
    "schema_valid_provider_output_storage_tier": "T1",
    "storage_promotes_trust": false,
    "retrieval_promotes_trust": false,
    "persistence_is_verification": false,
    "notes": ["Retrieval is not verification."]
  },
  "trust_cap": {
    "raw_provider_output_trust_tier": "T0",
    "schema_valid_provider_output_trust_tier": "T1",
    "max_provider_output_trust_tier": "T1",
    "provider_slot_selection_promotes_trust": false,
    "explicit_opt_in_promotes_trust": false,
    "api_key_presence_promotes_trust": false,
    "network_success_promotes_trust": false,
    "provider_identity_promotes_trust": false,
    "successful_provider_response_promotes_trust": false,
    "provider_output_is_deterministic_evidence": false,
